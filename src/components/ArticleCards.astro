---
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<div class="articles">
  {
    posts.map((post) => (
      <article class="article-card">
        <div class="article-meta">
          {post.category ? (
            <a class="category-link" href={getPermalink(post.category.slug, 'category')}>
              {post.category.title}
            </a>
          ) : (
            <span>随笔</span>
          )}
          <time datetime={post.publishDate.toISOString()}>
            {post.publishDate.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}
          </time>
        </div>
        <div class="article-card-content">
          <h3>
            <a href={getPermalink(post.permalink, 'post')}>{post.title}</a>
          </h3>
          <p>{post.excerpt}</p>
          <a class="article-bottom" href={getPermalink(post.permalink, 'post')}>
            阅读全文
          </a>
        </div>
      </article>
    ))
  }
</div>
