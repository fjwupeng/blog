---
import { Icon } from 'astro-icon/components';
import { fetchPosts } from '~/utils/blog';
const posts = await fetchPosts();
const entries = [
  ...posts.map((p) => ({ title: p.title, description: p.excerpt || '', href: `/${p.permalink}`, kind: '文章' })),
  { title: '跟卖雷达', description: '亚马逊跟卖场景与项目实践', href: '/projects', kind: '作品' },
  { title: 'AI 企业增长项目', description: '品牌信息、内容分发与公开实验', href: '/#experiments', kind: '实验' },
  { title: '关于吴鹏', description: '独立开发者与 AI 创业探索者', href: '/about', kind: '关于' },
];
---

<button type="button" class="search-trigger" aria-label="搜索文章和作品" aria-haspopup="dialog"
  ><Icon name="tabler:search" /></button
>
<dialog class="search-dialog" aria-labelledby="search-heading">
  <div class="search-heading">
    <h2 id="search-heading">搜索文章和作品</h2><button type="button" class="search-close" aria-label="关闭搜索"
      ><Icon name="tabler:x" /></button
    >
  </div><label class="search-field"
    ><Icon name="tabler:search" /><input
      id="site-search-input"
      type="search"
      placeholder="输入关键词，如 AI、个人网站…"
      aria-label="搜索关键词"
      autocomplete="off"
    /></label
  ><p class="search-count" aria-live="polite">输入关键词，查找本站内容。</p><ul class="search-results">
    {
      entries.map((item) => (
        <li data-search={`${item.title} ${item.description}`}>
          <a href={item.href}>
            <>
              <span>{item.kind}</span>
              <strong>{item.title}</strong>
              <p>{item.description}</p>
            </>
          </a>
        </li>
      ))
    }
  </ul><p class="search-empty" hidden>没有找到相关内容，试试“AI”或“文章”。</p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  const input = document.querySelector<HTMLInputElement>('#site-search-input');
  const trigger = document.querySelector<HTMLButtonElement>('.search-trigger');
  if (dialog && input && trigger) {
    const results = Array.from(dialog.querySelectorAll<HTMLElement>('[data-search]'));
    const counter = dialog.querySelector<HTMLElement>('.search-count');
    const empty = dialog.querySelector<HTMLElement>('.search-empty');
    trigger.addEventListener('click', () => {
      dialog.showModal();
      input.focus();
    });
    dialog.querySelector('.search-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    input.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase();
      let count = 0;
      for (const item of results) {
        const matches = (item.dataset.search || '').toLocaleLowerCase().includes(query);
        item.hidden = !matches;
        if (matches) count++;
      }
      if (counter) counter.textContent = query ? `找到 ${count} 项相关内容` : '输入关键词，查找本站内容。';
      if (empty) empty.hidden = count > 0;
    });
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
  }
</script>
