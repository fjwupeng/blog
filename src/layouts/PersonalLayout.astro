---
import '~/assets/styles/personal.css';
import '~/assets/styles/home-design.css';
import SiteSearch from '~/components/SiteSearch.astro';
import { SITE } from 'astrowind:config';
import { author as siteAuthor } from '~/data/author';
import { getCanonical, getPermalink } from '~/utils/permalinks';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  updated?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  index?: boolean;
  breadcrumbs?: Array<{ name: string; href: string }>;
  faq?: Array<{ question: string; answer: string }>;
}
const {
  title = '吴鹏 · 保持好奇，持续创造',
  description = '吴鹏的个人网站，记录 AI 应用、互联网业务与个人品牌建设中的思考和实践。',
  article = false,
  date,
  updated,
  category,
  tags = [],
  author = siteAuthor.name,
  index = true,
  breadcrumbs = [],
  faq = [],
} = Astro.props;
const canonical = String(getCanonical(Astro.url.pathname));
const siteUrl = new URL('/', SITE.site).href;
const personId = `${getCanonical('/about/')}#person`;
const websiteId = `${siteUrl}#website`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: siteAuthor.name,
  alternateName: siteAuthor.handle,
  url: String(getCanonical('/about/')),
  description: siteAuthor.description,
  jobTitle: siteAuthor.role,
  image: new URL(siteAuthor.image, SITE.site).href,
  sameAs: [siteAuthor.github],
  telephone: siteAuthor.telephone,
  contactPoint: { '@type': 'ContactPoint', contactType: '交流与合作', telephone: siteAuthor.telephone },
  knowsAbout: siteAuthor.topics,
};
const nav = [
  ['首页', '/'],
  ['关于我', '/about'],
  ['文章', '/articles'],
  ['公开实验', '/experiments'],
  ['我的作品', '/projects'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
const pageType =
  path === '/about'
    ? ['AboutPage', 'ProfilePage']
    : path === '/contact'
      ? 'ContactPage'
      : path === '/faq' && faq.length
        ? 'FAQPage'
        : ['/articles', '/experiments', '/projects'].some(
              (base) => path === base || (base === '/articles' && path.startsWith('/articles/category/'))
            )
          ? 'CollectionPage'
          : 'WebPage';
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: '吴鹏 · 个人官网',
      url: siteUrl,
      inLanguage: 'zh-CN',
      publisher: { '@id': personId },
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'zh-CN',
      isPartOf: { '@id': websiteId },
      author: { '@id': personId },
      ...(date ? { datePublished: date.toISOString() } : {}),
      ...(updated ? { dateModified: updated.toISOString() } : {}),
      ...(path === '/about' ? { mainEntity: { '@id': personId } } : {}),
      ...(article ? { mainEntity: { '@id': `${canonical}#article` } } : {}),
      ...(faq.length
        ? {
            ...(path === '/faq'
              ? {
                  mainEntity: faq.map((item) => ({
                    '@type': 'Question',
                    name: item.question,
                    acceptedAnswer: { '@type': 'Answer', text: item.answer },
                  })),
                }
              : {
                  hasPart: {
                    '@type': 'FAQPage',
                    '@id': `${canonical}#faq`,
                    mainEntity: faq.map((item) => ({
                      '@type': 'Question',
                      name: item.question,
                      acceptedAnswer: { '@type': 'Answer', text: item.answer },
                    })),
                  },
                }),
          }
        : {}),
      ...(breadcrumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...(article
      ? [
          {
            '@type': 'BlogPosting',
            '@id': `${canonical}#article`,
            url: canonical,
            headline: title,
            description,
            datePublished: date?.toISOString(),
            dateModified: (updated || date)?.toISOString(),
            articleSection: category,
            keywords: tags.join(', '),
            inLanguage: 'zh-CN',
            author: author === siteAuthor.name ? { '@id': personId } : { '@type': 'Person', name: author },
            publisher: { '@id': personId },
            mainEntityOfPage: { '@id': `${canonical}#webpage` },
          },
        ]
      : []),
    ...(breadcrumbs.length
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: breadcrumbs.map((item, position) => ({
              '@type': 'ListItem',
              position: position + 1,
              name: item.name,
              item: String(getCanonical(item.href)),
            })),
          },
        ]
      : []),
  ],
};
const verification = [
  ['baidu-site-verification', import.meta.env.BAIDU_SITE_VERIFICATION],
  ['msvalidate.01', import.meta.env.BING_SITE_VERIFICATION],
  ['google-site-verification', import.meta.env.GOOGLE_SITE_VERIFICATION],
].filter(([, value]) => value);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title.includes('吴鹏') ? title : `${title} · 吴鹏`}</title>
    <meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={index ? 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1' : 'noindex,follow'}
    />
    <meta name="author" content={author} />
    {verification.map(([name, value]) => <meta name={name} content={value} />)}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta
      property="og:type"
      content={article ? 'article' : 'website'}
    /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="吴鹏 · 个人官网" /><meta
      property="og:locale"
      content="zh_CN"
    />
    <meta property="og:image" content={new URL(siteAuthor.image, SITE.site).href} />
    <meta property="og:image:alt" content="吴鹏的户外肖像" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(siteAuthor.image, SITE.site).href} />
    {article && <meta property="article:published_time" content={date?.toISOString()} />}
    {article && <meta property="article:modified_time" content={(updated || date)?.toISOString()} />}
    {article && category && <meta property="article:section" content={category} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="alternate"
      type="application/rss+xml"
      title="吴鹏的文章"
      href="/rss.xml"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="吴鹏，返回首页"
          ><span class="brand-mark" aria-hidden="true">WP<span>.</span></span><span class="brand-copy"
            ><strong>吴鹏</strong><small>独立开发者 · AI 创业探索者</small></span
          ></a
        >
        <nav class="nav desktop-nav" aria-label="主导航">
          {
            nav.map(([label, href]) => (
              <a href={getPermalink(href)} aria-current={active(href) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions"><SiteSearch /><a class="contact-button" href="/contact/">联系我</a></div>
        <details class="menu">
          <summary>菜单</summary><nav class="nav" aria-label="移动导航">
            {
              nav.map(([label, href]) => (
                <a href={getPermalink(href)} aria-current={active(href) ? 'page' : undefined}>
                  {label}
                </a>
              ))
            }
            <a href="/contact/">联系我</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} 吴鹏 · 保持好奇，持续创造。</span><div class="footer-links">
          <a href="/about/">关于我</a><a href="/faq/">常见问题</a><a href="/rss.xml">RSS 订阅</a><a href="/contact/"
            >联系</a
          >
          <a href="/privacy/">隐私政策</a><a href="/terms/">使用条款</a>
        </div>
      </div>
    </footer>
  </body>
</html>
