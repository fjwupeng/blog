---
import Layout from '~/layouts/PersonalLayout.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';
export async function getStaticPaths() {
  return (await fetchPosts()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props {
  post: Post;
}
const { post } = Astro.props;
const Content = post.Content;
---

<Layout
  title={post.title}
  description={post.excerpt}
  article
  date={post.publishDate}
  updated={post.updateDate}
  category={post.category?.title}
  tags={post.tags?.map((tag) => tag.title)}
  ><article class="longread">
    <a href="/articles" class="text-link">全部文章</a><h1>{post.title}</h1><div class="article-meta">
      <a href="/about">{post.author || '吴鹏'}</a><time datetime={post.publishDate.toISOString()}
        >发布于 {post.publishDate.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}</time
      >{
        post.updateDate && (
          <time datetime={post.updateDate.toISOString()}>
            更新于 {post.updateDate.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}
          </time>
        )
      }
      {
        post.category && (
          <a class="category-link" href={getPermalink(post.category.slug, 'category')}>
            {post.category.title}
          </a>
        )
      }
    </div><p class="lead">{post.excerpt}</p><div class="prose">{Content && <Content />}</div><div class="article-end">
      本文由吴鹏的个人网站发布。<a class="text-link" href="/about">了解作者</a> · <a class="text-link" href="/articles"
        >继续阅读</a
      >
    </div>
  </article></Layout
>
