---
import Layout from '~/layouts/PersonalLayout.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink, getCanonical } from '~/utils/permalinks';
import { author } from '~/data/author';
import type { Post } from '~/types';
export async function getStaticPaths() {
  return (await fetchPosts()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props {
  post: Post;
}
const { post } = Astro.props;
const Content = post.Content;
const originalUrl = String(getCanonical(`/${post.permalink}`));
const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/articles/' },
  ...(post.category ? [{ name: post.category.title, href: getPermalink(post.category.slug, 'category') }] : []),
  { name: post.title, href: `/${post.permalink}` },
];
---

<Layout
  title={post.title}
  description={post.excerpt}
  article
  date={post.publishDate}
  updated={post.updateDate}
  category={post.category?.title}
  tags={post.tags?.map((tag) => tag.title)}
  author={post.author || author.name}
  breadcrumbs={breadcrumbs}
  ><article class="longread">
    <nav class="breadcrumbs" aria-label="当前位置">
      {breadcrumbs.slice(0, -1).map((item) => <a href={item.href}>{item.name}</a>)}<span>正文</span>
    </nav><h1>{post.title}</h1><div class="article-meta">
      {
        !post.author || post.author === author.name ? (
          <a href="/about/">{post.author || author.name}</a>
        ) : (
          <span>{post.author}</span>
        )
      }<time datetime={post.publishDate.toISOString()}
        >发布于 {post.publishDate.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}</time
      >{
        post.updateDate && (
          <time datetime={post.updateDate.toISOString()}>
            更新于 {post.updateDate.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}
          </time>
        )
      }
      {
        post.category && (
          <a class="category-link" href={getPermalink(post.category.slug, 'category')}>
            {post.category.title}
          </a>
        )
      }
    </div><p class="lead">{post.excerpt}</p>
    {
      post.takeaways?.length && (
        <aside class="article-summary" aria-labelledby="summary-heading">
          <>
            <h2 id="summary-heading">这篇文章的要点</h2>
            <ul>
              {post.takeaways.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </>
        </aside>
      )
    }
    <div class="prose">{Content && <Content />}</div>
    {
      post.references?.length && (
        <section class="article-references" aria-labelledby="references-heading">
          <>
            <h2 id="references-heading">参考与相关资料</h2>
            <ul>
              {post.references.map((reference) => (
                <li>
                  <a href={reference.url}>{reference.title}</a>
                </li>
              ))}
            </ul>
          </>
        </section>
      )
    }
    <div class="article-end">
      {
        (!post.author || post.author === author.name) && (
          <div class="article-author">
            <>
              <strong>
                作者：<a href="/about/">{author.name}</a>
              </strong>
              <p>{author.description}</p>
            </>
          </div>
        )
      }
      <p>引用本文时，请注明作者 {post.author || author.name}，并附原文链接。引用前可核对本文的更新时间与相关资料。</p>
      <a class="original-url" href={originalUrl}>{originalUrl}</a>
      <p><a class="text-link" href="/articles/">继续阅读其他文章</a></p>
    </div>
  </article></Layout
>
