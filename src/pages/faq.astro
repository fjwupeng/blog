---
import Layout from '~/layouts/PersonalLayout.astro';
import { siteFaq } from '~/data/site-faq';
---

<Layout
  title="关于吴鹏与本站的常见问题"
  description="吴鹏的背景、跟卖雷达、公开实验、文章更新与引用方式。"
  faq={siteFaq}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: '常见问题', href: '/faq/' },
  ]}
>
  <article class="longread">
    <nav class="breadcrumbs" aria-label="当前位置"><a href="/">首页</a><span>常见问题</span></nav>
    <div class="eyebrow">QUESTIONS / 常见问题</div><h1>关于我与这个网站。</h1>
    <p class="lead">从这里快速了解我的背景、作品与文章。具体内容可以沿着每个回答中的链接继续阅读。</p>
    <div class="faq-list">
      {
        siteFaq.map((item, i) => (
          <section id={`question-${i + 1}`}>
            <>
              <h2>{item.question}</h2>
              <p>{item.answer}</p>
              <a class="text-link" href={item.href}>
                {item.linkLabel}
              </a>
            </>
          </section>
        ))
      }
    </div>
  </article>
</Layout>
