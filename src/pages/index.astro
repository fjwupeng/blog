---
import Layout from '~/layouts/PersonalLayout.astro';
import { Icon } from 'astro-icon/components';
import ArticleCards from '~/components/ArticleCards.astro';
import { findLatestPosts } from '~/utils/blog';
import { experiments } from '~/data/experiments';
import { siteFaq } from '~/data/site-faq';
import { homepage } from '~/data/homepage';
import { author } from '~/data/author';
const posts = await findLatestPosts({ count: 2 });
const experiment = experiments[0];
const displayDate = (value: string) =>
  new Date(value).toLocaleDateString('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
const abilities = [
  { icon: 'tabler:code', title: '全栈开发', description: '从需求到上线的完整交付能力' },
  { icon: 'tabler:cube', title: '产品创造', description: '把真实问题转化为可用产品' },
  { icon: 'tabler:bulb', title: '独立思考', description: '分享对 AI、技术和商业的判断' },
  { icon: 'tabler:chart-line', title: '持续成长', description: '记录过程、成果、失败与复盘' },
];
---

<Layout
  title={homepage.title}
  pageName="你好，我是吴鹏。 保持好奇，持续创造。"
  description={homepage.description}
  date={homepage.publishedAt}
  updated={new Date(homepage.updatedAt)}
  faq={siteFaq}
>
  <section class="brand-hero" aria-labelledby="hero-heading">
    <img
      class="hero-backdrop"
      src="/images/hero-reference-v2-2172.webp"
      srcset="/images/hero-reference-v2-768.webp 768w, /images/hero-reference-v2-1536.webp 1536w, /images/hero-reference-v2-2172.webp 2172w"
      sizes="100vw"
      alt="吴鹏的户外肖像，背景为湖畔与城市远景；寄语：用技术实现想法，用产品探索商业，用实践验证认知。"
      fetchpriority="high"
      width="2172"
      height="724"
    />
    <div class="home-wrap hero-body">
      <div class="hero-message">
        <div class="builder-label"><span></span>INDEPENDENT BUILDER</div>
        <h1 id="hero-heading">你好，我是吴鹏。<br /><span>保持好奇，持续创造。</span></h1>
        <p>
          一名全栈开发者，热爱技术和产品，正在利用 AI 探索独立创业的更多可能。<br
          />这里记录我的项目、思考、实验，以及从想法到产品的真实过程。
        </p>
        <div class="hero-buttons">
          <a class="hero-primary" href="/about/">了解我<Icon name="tabler:arrow-right" /></a><a
            class="hero-secondary"
            href="/articles/">查看最新文章</a
          >
        </div>
      </div>
    </div>
  </section>
  <section class="ability-strip" aria-label="我的关注与能力">
    <div class="home-wrap ability-grid">
      {
        abilities.map((item) => (
          <div class="ability">
            <>
              <Icon name={item.icon} />
              <div>
                <>
                  <h2>{item.title}</h2>
                  <p>{item.description}</p>
                </>
              </div>
            </>
          </div>
        ))
      }
    </div>
  </section>
  <div class="home-wrap">
    <section class="home-overview">
      <section class="home-about">
        <div class="home-label"><Icon name="tabler:focus-2" />关于我</div><h2>一个热爱创造的独立开发者</h2><p>
          我是一名全栈开发者，拥有电商、SaaS、医疗等领域的项目经验。<br />我喜欢从零构建产品，也持续探索 AI
          对软件开发和互联网创业带来的新机会。
        </p><p>
          我相信，一个人也可以借助技术和 AI，做出真正有价值的产品。<br
          />这个网站记录我的技术实践、产品开发、创业思考和成长过程。
        </p><a class="home-link about-link" href="/about/">了解更多关于我<Icon name="tabler:arrow-right" /></a>
      </section>
      <div class="home-work">
        <div class="work-heading">
          <h2 class="home-label">作品与探索</h2><a class="home-link" href="/projects/"
            >查看全部作品<Icon name="tabler:arrow-right" /></a
          >
        </div>
        <div class="work-cards">
          <article class="work-card">
            <span class="work-status live">已上线</span><div class="work-title">
              <span class="work-icon orange"><Icon name="tabler:radar-2" /></span><div>
                <h3>跟卖雷达</h3><p>跨境电商数据探索与选品辅助工具</p>
              </div>
            </div><p class="work-description">
              围绕亚马逊跟卖场景部署的工具，正在推进首批使用，持续收集真实业务中的反馈。
            </p><ul class="work-tags" aria-label="项目标签"><li>跨境电商</li><li>数据分析</li><li>独立产品</li></ul><a
              class="home-link"
              href="https://genmai.jianduai.cn/"
              target="_blank"
              rel="noopener noreferrer">访问官网<Icon name="tabler:external-link" /></a
            >
          </article>
          <article class="work-card">
            <span class="work-status research">研究中</span><div class="work-title">
              <span class="work-icon blue"><Icon name="tabler:stack-2-filled" /></span><div>
                <h3>AI 企业增长项目</h3><p>帮助企业统一管理信息并提升传播效率</p>
              </div>
            </div><p class="work-description">
              正在研究如何通过 AI 帮助企业管理品牌信息、多渠道内容分发，并持续验证搜索与品牌表现。
            </p><ul class="work-tags" aria-label="项目标签"><li>AI 应用</li><li>内容分发</li><li>品牌监测</li></ul><a
              class="home-link"
              href={`/experiments/${experiment.slug}/`}>查看实验进展<Icon name="tabler:arrow-right" /></a
            >
          </article>
        </div>
        <p>
          比如，跟卖雷达是我围绕亚马逊跟卖场景推进的一项工具实践。它有自己的产品入口，也有需要继续收集的使用反馈。官网可以把这些背景接起来，让一个作品成为认识我的线索。
        </p>
      </div>
    </section>
    <section class="home-articles">
      <div class="home-section-heading">
        <h2>最新文章</h2><a class="home-link" href="/articles/">查看全部文章<Icon name="tabler:arrow-right" /></a>
      </div><ArticleCards posts={posts} />
    </section>
    <section id="experiments" class="home-experiments">
      <div class="home-section-heading">
        <div><span class="home-label">BUILD IN PUBLIC</span><h2>公开实验</h2></div><a
          class="home-link"
          href="/experiments/">查看全部实验<Icon name="tabler:arrow-right" /></a
        >
      </div><article class="experiment-row">
        <div>
          <span class="work-status research">{experiment.status}</span><h3>{experiment.title}</h3><p>
            {experiment.focus}
          </p>
        </div><a class="home-link" href={`/experiments/${experiment.slug}/`}
          >查看实验进展<Icon name="tabler:arrow-right" /></a
        >
      </article>
      <p>{experiment.description}</p>
      <p>{experiment.question}</p>
      <p>{experiment.context}</p>
      <div class="home-faq">
        {
          experiment.milestones.map((milestone) => (
            <section>
              <h3>
                {milestone.label}：{milestone.title}
              </h3>
              <p>{milestone.description}</p>
            </section>
          ))
        }
      </div>
    </section>
    <section class="home-notes" aria-labelledby="content-heading">
      <h2 id="content-heading">作品、实验和文章，各自回答一个问题</h2>
      <p>为了让网站容易理解，我把内容分成三个入口：</p>
      <ul>
        <li>我的作品：已经可以访问的产品，以及它回应的实际场景。</li>
        <li>公开实验：仍在探索的问题、当前进展和下一步打算验证的事情。</li>
        <li>文章：从实践中整理出的想法与方法，按主题分类，方便持续阅读。</li>
      </ul>
      <p>
        它们会有关联。例如，一项实验可能产生一篇文章；一个想法经过验证，也可能成为产品。但读者点击某个入口时，应该能看到这个入口所承诺的内容。
      </p>
      <p>
        我希望这里既能展示做出来的东西，也能留下尚未完成的过程。一个方向还在研究，就清楚地写“研究中”；一个结论缺少证据，就先保留为待验证的问题。
      </p>
      <a class="home-link" href="/articles/a-place-for-my-work/"
        >为什么我要搭建一个自己的个人网站<Icon name="tabler:arrow-right" /></a
      >
    </section>
    <section class="home-notes" aria-labelledby="record-heading">
      <h2 id="record-heading">从具体的记录开始，而不是一次填满</h2>
      <p>
        我不想为了让网站显得丰富，先写很多没有实践支撑的内容。更适合我的节奏，是遇到一个真实问题，就记录一次：需求从哪里来，为什么做出这个选择，使用反馈改变了什么，还有哪些问题没有答案。文章可以先讲清楚一件小事，再随着新的经验补充。接下来，我会从个人网站的内容管理和多平台发布开始，把过程记录在公开实验中。同时继续推进已有产品，整理值得分享的开发与产品经验。这个网站会随着实际工作逐渐丰富。我希望别人以后再打开它时，能看到一个人在持续行动，也能看懂这些行动之间的联系。因此，我想把介绍、作品和文章放在一起。读者可以先认识我，再通过具体内容判断：我的关注点是否与他有关，我们是否有值得交流的问题。
      </p>
    </section>
    <section class="home-notes" aria-labelledby="practice-heading">
      <h2 id="practice-heading">我如何维护这个网站？</h2>
      <p>
        本站已经采用 Markdown 管理文章：原稿放在 GitHub 仓库里，提交更新后，Cloudflare Pages
        会自动构建网站。文章分类、列表和详情也会随构建更新。
      </p>
      <p>
        对我来说，这解决了“原稿应该放在哪里”的问题。后续发现表达不清或需要补充时，先修改仓库中的文件，保留文章地址，再按发布记录检查其他版本。
      </p>
      <p>
        根据 <a href="https://developers.cloudflare.com/pages/configuration/git-integration/"
          >Cloudflare Pages 官方文档</a
        >，Git 推送可以触发自动部署。本站的原稿与修改记录见 <a
          href="https://github.com/fjwupeng/blog/tree/main/src/data/post">GitHub 文章目录</a
        >；目前自动完成的是官网更新，各个平台的稿件改写和发布仍需要单独处理，我还没有接入跨平台自动发布。
      </p>
      <a class="home-link" href="/articles/one-article-many-channels/"
        >阅读完整的内容维护流程<Icon name="tabler:arrow-right" /></a
      >
    </section>
    <section id="faq" class="home-notes" aria-labelledby="faq-heading">
      <h2 id="faq-heading">关于我与本站的常见问题</h2>
      <div class="home-faq">
        {
          siteFaq.map((item) => (
            <section>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </section>
          ))
        }
      </div>
      <p class="home-byline">
        作者：<a href="/about/" rel="author">{author.name}</a> · {author.role}<br />
        首页发布：<time datetime={homepage.publishedAt}>{displayDate(homepage.publishedAt)}</time> · 更新：<time
          datetime={new Date(homepage.updatedAt).toISOString()}>{displayDate(homepage.updatedAt)}</time
        ><br />
        交流与合作：<a href="tel:13123040176">13123040176</a> · <a href={author.github} rel="me">GitHub：fjwupeng</a>
      </p>
    </section>
  </div>
</Layout>
